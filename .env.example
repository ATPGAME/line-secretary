# ใส่ค่าชุดเดียวกันนี้ทั้งบน Vercel (webhook) และ Railway (worker)
# ในเครื่องตัวเอง: คัดลอกเป็น .env.local

# 1) LINE Developers > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 2) openrouter.ai > Keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_STT_MODEL=openai/whisper-1

# 2.1) (ไม่ใส่ก็ได้) ถอดเสียงด้วย ElevenLabs Scribe — แม่นภาษาไทยกว่า Whisper
#      ไม่ใส่ = ใช้ Whisper ผ่าน OpenRouter key ข้างบน ไม่ต้องสมัครเพิ่ม
ELEVENLABS_API_KEY=

# 3) Neon — กดสร้างในหน้า Vercel > Storage (ไม่ต้องสมัคร neon.tech แยก)
#    ดึงลงมาใส่ไฟล์นี้ด้วย:  node scripts/push-env.mjs pull
DATABASE_URL=

# 4) LINE userId ของเจ้าของ (คนที่จะรับรายงานสรุปกลุ่ม)
#    ทักบอทว่า "ไอดี" แล้วมันจะตอบกลับมาให้
OWNER_USER_ID=

# 4.1) (โหมดฟรี) รหัสให้ Vercel cron ยิงเข้า /api/cron ได้ — สุ่มเอา ไม่ต้องจำ
#      ไม่ได้ใช้ Railway ก็ตั้งอันนี้แทน จะได้สรุปกลุ่มวันละครั้งตอนเช้า
CRON_SECRET=

# 5) รหัสเปิดหน้า /dashboard — ตั้งเองอะไรก็ได้ที่เดายาก
DASHBOARD_KEY=

# 6) (ไม่ใส่ก็ได้) ชื่อบอทที่โชว์บนหน้า /dashboard
BOT_NAME=

# 7) (ไม่ใส่ก็ได้) ทับบุคลิกใน lib/persona.js ด้วย env — แก้บุคลิกโดยไม่ต้อง deploy ใหม่
PERSONA=

# 8) (ไม่ใส่ก็ได้) DASHBOARD_PUBLIC=1 → เปิด /dashboard ให้ใครก็เข้าได้ ไม่ต้องมี ?key=
#    ⚠️ ข้อมูลลูกค้า/ยอดเงิน/สรุปกลุ่มจะเปิดสาธารณะทั้งหมด ตั้งใจแล้วค่อยเปิด
DASHBOARD_PUBLIC=

# 9) (ไม่ใส่ก็ได้) ทีม Vercel เป็น Pro เท่านั้น — ตั้ง CRON_FREQUENT=1 คู่กับการเปลี่ยน
#    schedule ใน vercel.json เป็น "*/10 * * * *" → ได้สรุปตาม report_hours (เช้า-เย็น)
#    + เตือนลูกค้าถามค้าง โดยไม่ต้องจ่าย Railway
CRON_FREQUENT=

# 10) (ไม่ใส่ก็ได้) REPLY_TO_ALL=1 → ตอบทุกคนที่แอด OA มา
#     ค่า default (ไม่ใส่) = ตอบเฉพาะ OWNER_USER_ID เท่านั้น — คนแปลกหน้าแอดมาแล้วทัก บอทจะเงียบ
#     กันคนอื่นมาใช้เครดิต OpenRouter ของเรา และกันเลขาส่วนตัวหลุดออกนอกวง
REPLY_TO_ALL=

